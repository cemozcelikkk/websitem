{
  "name": "websitem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:drafts": "vite --mode drafts",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.ts",
    "build:drafts": "tsc -b && vite build --mode drafts && vite build --mode drafts --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.ts",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "node --test \"tests/*.test.ts\"",
    "test:dist": "node --test \"tests/dist/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "mermaid": "^12.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "marked": "^18.1.1",
    "oxlint": "^1.81.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  }
}
